   __asm { mov fp, ebp}                                                         \
   ;  // NOLINT
 // clang-format on
-#elif defined(HOST_ARCH_X64)
+#elif defined(HOST_ARCH_X64) || defined(HOST_ARCH_ARM64)
 // We don't have the asm equivalent to get at the frame pointer on
