diff --git a/a/runtime/vm/thread_interrupter_win.cc b/b/runtime/vm/thread_interrupter_win.cc

--- a/runtime/vm/thread_interrupter_win.cc
+++ b/runtime/vm/thread_interrupter_win.cc
@@ -5,6 +5,9 @@
 #include "platform/globals.h"
 #if defined(HOST_OS_WINDOWS)
 
+#if defined(TARGET_ARCH_ARM64)
+#include "vm/constants_arm64.h"  // WINDARTARM: SPREG - arm64's Dart stack pointer
+#endif
 #include "vm/flags.h"
 #include "vm/os.h"
 #include "vm/profiler.h"
@@ -31,6 +34,10 @@ class ThreadInterrupterWin : public AllStatic {
     // On X64, CONTEXT_CONTROL includes Rip and Rsp. Rbp is classified
     // as an "integer" register.
     context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+#elif defined(HOST_ARCH_ARM64)
+    // WINDARTARM: CONTEXT_CONTROL gives Pc/Sp/Fp/Lr; CONTEXT_INTEGER gives
+    // X0..X28 - and we need X15, which is Dart's SPREG (see below).
+    context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
 #else
 #error Unsupported architecture.
 #endif
@@ -45,6 +52,18 @@ class ThreadInterrupterWin : public AllStatic {
       state->fp = static_cast<uintptr_t>(context.Rbp);
       state->csp = static_cast<uintptr_t>(context.Rsp);
       state->dsp = static_cast<uintptr_t>(context.Rsp);
+#elif defined(HOST_ARCH_ARM64)
+      // WINDARTARM: arm64 Dart runs on TWO stack pointers - the hardware SP
+      // (CSP == R31) for the C++ world, and R15 (SPREG) as the Dart stack
+      // pointer (constants_arm64.h:115; Assembler::EnterFrame keeps CSP a page
+      // below SP and 16-byte aligned). csp and dsp are therefore DIFFERENT
+      // registers here, exactly as signal_handler_linux.cc's
+      // GetDartStackPointer reads mcontext.regs[SPREG] on arm64. Reporting Sp
+      // for dsp would make every Dart stack walk in the profiler fail.
+      state->pc = static_cast<uintptr_t>(context.Pc);
+      state->fp = static_cast<uintptr_t>(context.Fp);
+      state->csp = static_cast<uintptr_t>(context.Sp);
+      state->dsp = static_cast<uintptr_t>(context.X[SPREG]);
 #else
 #error Unsupported architecture.
 #endif
diff --git a/a/runtime/vm/os_thread_win.cc b/b/runtime/vm/os_thread_win.cc
--- a/runtime/vm/os_thread_win.cc
+++ b/runtime/vm/os_thread_win.cc
@@ -177,7 +177,16 @@ bool OSThread::GetCurrentStackBounds(uword* lower, uword* upper) {
 // On Windows stack limits for the current thread are available in
 // the thread information block (TIB). Its fields can be accessed through
 // FS segment register on x86 and GS segment register on x86_64.
-#ifdef _WIN64
+#if defined(_M_ARM64)
+  // WINDARTARM: there is no GS segment on arm64 — the TEB lives in x18, which
+  // is exactly what NtCurrentTeb() compiles to (winnt.h defines it as a read
+  // of register 18 under _M_ARM64). The TEB's leading NT_TIB carries the same
+  // StackBase/StackLimit fields on every architecture, so read them through
+  // the portable accessor instead of a segment-register intrinsic.
+  NT_TIB* tib = reinterpret_cast<NT_TIB*>(NtCurrentTeb());
+  *upper = reinterpret_cast<uword>(tib->StackBase);
+  *lower = reinterpret_cast<uword>(tib->StackLimit);
+#elif defined(_WIN64)
   *upper = static_cast<uword>(__readgsqword(offsetof(NT_TIB64, StackBase)));
   *lower = static_cast<uword>(__readgsqword(offsetof(NT_TIB64, StackLimit)));
 #else
