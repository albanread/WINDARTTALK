# WINDARTARM - windows-arm64 (Snapdragon) VM-core delta against pristine Dart 1.24.3.
#
# Companion to port-win/windart-port.patch (which stays arch-neutral + x64). Apply
# BOTH: this file carries ONLY the arm64/Windows arch seam. Eight files, 20 hunks.
# Every hunk was verified to compile with MSVC 14.51 (VS 18) targeting arm64 on a
# Snapdragon X (Oryon) host - see WINDOWS_ARM64_PORTING_PLAN.md SS2.
#
#   platform/globals.h        - teach arch detection that MSVC spells arm64 _M_ARM64.
#                               THE KEYSTONE: without it the build either #errors or
#                               silently selects USING_SIMULATOR (an interpreter, not a JIT).
#   vm/globals.h              - COPY_FP_REGISTER: arm64 joins the x64 branch.
#   vm/atomic_win.h           - 9 gates: the Interlocked* bodies are already arm64-correct.
#   vm/cpu_arm64.cc           - FlushICache via FlushInstructionCache. arm64's i-cache is
#                               NOT coherent; this is the JIT-defining change (the analogue
#                               of MACDART's sys_icache_invalidate fix).
#   vm/cpuinfo_win.cc         - no CPUID on arm64; read the CPU name from the registry.
#   vm/thread_interrupter_win.cc - profiler: sample Pc/Fp/Sp AND X15 (Dart's SPREG).
#   vm/os_thread_win.cc       - stack bounds via NtCurrentTeb()->NT_TIB: no GS segment
#                               on arm64 (found by the AS1 burn-down, not the A0 probe).
#   third_party/double-conversion/src/utils.h - same _M_ARM64 blind spot.
#
# NOT in this patch (build-flag fixes, no source edit needed):
#   /D_ARM64_NO_EXTENDED_INTRINSICS - suppresses arm64_neon.h's #define mvn(src),
#   which collides with Assembler::mvn (assembler_arm64.h:1062 + 2 call sites).
diff --git a/a/runtime/platform/globals.h b/b/runtime/platform/globals.h

--- a/runtime/platform/globals.h
+++ b/runtime/platform/globals.h
@@ -249,7 +249,7 @@ typedef double fpu_register_t;
 #elif defined(__MIPSEB__)
 #error Big-endian MIPS is not supported by Dart. Try passing -EL to your      \
  compiler.
-#elif defined(__aarch64__)
+#elif defined(__aarch64__) || defined(_M_ARM64)
 #define HOST_ARCH_ARM64 1
 #define ARCH_IS_64_BIT 1
 #define kFpuRegisterSize 16
diff --git a/a/runtime/third_party/double-conversion/src/utils.h b/b/runtime/third_party/double-conversion/src/utils.h

--- a/runtime/third_party/double-conversion/src/utils.h
+++ b/runtime/third_party/double-conversion/src/utils.h
@@ -76,7 +76,7 @@ inline void abort_noreturn() { abort(); }
     defined(__sparc__) || defined(__sparc) || defined(__s390__) || \
     defined(__SH4__) || defined(__alpha__) || \
     defined(_MIPS_ARCH_MIPS32R2) || \
-    defined(__AARCH64EL__) || defined(__aarch64__)
+    defined(__AARCH64EL__) || defined(__aarch64__) || defined(_M_ARM64)
 #define DOUBLE_CONVERSION_CORRECT_DOUBLE_OPERATIONS 1
 #elif defined(__mc68000__)
 #undef DOUBLE_CONVERSION_CORRECT_DOUBLE_OPERATIONS
