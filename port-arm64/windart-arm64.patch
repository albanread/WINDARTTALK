diff --git a/a/runtime/vm/cpu_arm64.cc b/b/runtime/vm/cpu_arm64.cc

--- a/runtime/vm/cpu_arm64.cc
+++ b/runtime/vm/cpu_arm64.cc
@@ -11,7 +11,7 @@
 #include "vm/cpuinfo.h"
 #include "vm/simulator.h"
 
-#if !defined(USING_SIMULATOR)
+#if !defined(USING_SIMULATOR) && !defined(HOST_OS_WINDOWS)
 #include <sys/syscall.h> /* NOLINT */
 #include <unistd.h>      /* NOLINT */
 #endif
@@ -32,7 +32,15 @@ void CPU::FlushICache(uword start, uword size) {
 
 // ARM recommends using the gcc intrinsic __clear_cache on Linux and Android.
 // blogs.arm.com/software-enablement/141-caches-and-self-modifying-code/
-#if defined(HOST_OS_ANDROID) || defined(HOST_OS_FUCHSIA) ||                    \
+#if defined(HOST_OS_WINDOWS)
+  // WINDARTARM: arm64's i-cache is NOT coherent with the d-cache (unlike x64,
+  // where cpu_x64.cc's FlushICache is a documented no-op). Every JIT code write
+  // and every code_patcher_arm64 self-modification must be published to the
+  // i-cache or the CPU may execute stale bytes. FlushInstructionCache is the
+  // Win32 equivalent of Linux's __clear_cache / Darwin's sys_icache_invalidate.
+  ::FlushInstructionCache(::GetCurrentProcess(),
+                          reinterpret_cast<void*>(start), size);
+#elif defined(HOST_OS_ANDROID) || defined(HOST_OS_FUCHSIA) ||                  \
     defined(HOST_OS_LINUX)
   extern void __clear_cache(char*, char*);
   char* beg = reinterpret_cast<char*>(start);
diff --git a/a/runtime/vm/cpuinfo_win.cc b/b/runtime/vm/cpuinfo_win.cc

--- a/runtime/vm/cpuinfo_win.cc
+++ b/runtime/vm/cpuinfo_win.cc
@@ -19,11 +19,36 @@ namespace dart {
 CpuInfoMethod CpuInfo::method_ = kCpuInfoDefault;
 const char* CpuInfo::fields_[kCpuInfoMax] = {0};
 
+#if defined(HOST_ARCH_ARM64)
+// WINDARTARM: arm64 has no CPUID instruction, so cpuid.h compiles CpuId down to
+// a stub whose field() returns NULL. A NULL model string then trips
+// HostCPUFeatures::Cleanup()'s ASSERT(hardware_ != NULL) in cpu_arm64.cc, and
+// leaves the Observatory/workspace VM tab with no CPU name. Windows publishes
+// the CPU name in the registry for every architecture -- on a Snapdragon X this
+// reads e.g. "Snapdragon(R) X Elite - X1E78100 - Qualcomm(R) Oryon(TM) CPU".
+// Caller owns the result, matching CpuId::field()'s contract.
+static const char* WindartArmCpuModel() {
+  char buf[256];
+  DWORD size = sizeof(buf);
+  if (::RegGetValueA(HKEY_LOCAL_MACHINE,
+                     "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
+                     "ProcessorNameString", RRF_RT_REG_SZ, NULL, buf,
+                     &size) == ERROR_SUCCESS) {
+    return strdup(buf);
+  }
+  return strdup("arm64");
+}
+#endif  // defined(HOST_ARCH_ARM64)
+
 void CpuInfo::InitOnce() {
+#if defined(HOST_ARCH_ARM64)
+  method_ = kCpuInfoSystem;  // WINDARTARM: registry, not cpuid.
+#else
   method_ = kCpuInfoCpuId;
 
   // Initialize the CpuId information.
   CpuId::InitOnce();
+#endif
 
   fields_[kCpuInfoProcessor] = "Processor";
   fields_[kCpuInfoModel] = "Hardware";
@@ -34,19 +59,32 @@ void CpuInfo::InitOnce() {
 
 
 void CpuInfo::Cleanup() {
+#if !defined(HOST_ARCH_ARM64)
   CpuId::Cleanup();
+#endif
 }
 
 
 bool CpuInfo::FieldContains(CpuInfoIndices idx, const char* search_string) {
   ASSERT(method_ != kCpuInfoDefault);
+#if defined(HOST_ARCH_ARM64)
+  const char* field = WindartArmCpuModel();
+  const bool result = (strstr(field, search_string) != NULL);
+  free(const_cast<char*>(field));
+  return result;
+#else
   return strstr(CpuId::field(idx), search_string);
+#endif
 }
 
 
 const char* CpuInfo::ExtractField(CpuInfoIndices idx) {
   ASSERT(method_ != kCpuInfoDefault);
+#if defined(HOST_ARCH_ARM64)
+  return WindartArmCpuModel();
+#else
   return CpuId::field(idx);
+#endif
 }
 
 
