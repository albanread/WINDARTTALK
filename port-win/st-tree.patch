+  noSuchMethod(Invocation inv) {
+    var hook = internal.VMLibraryHooks.stTypeNSM;
+    if (hook != null && inv.isMethod && inv.namedArguments.isEmpty) {
+      var r = hook(this, internal.Symbol.getName(inv.memberName),
+                   inv.positionalArguments);
